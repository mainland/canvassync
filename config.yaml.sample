api_url: "https://canvas.instructure.com"
api_key: "replace-with-your-canvas-api-token"
course_sis: "COURSE SIS ID"
# Alternatively, the numeric Canvas course ID. Takes precedence over
# course_sis. The --course-id command line option overrides both.
# course_id: 12345

# Create assignments that don't exist in Canvas (same as
# `sync --create-assignments`).
# create_assignments: true

# Weight the final grade by assignment group.
apply_assignment_group_weights: true

# Assignment groups are created or updated (never deleted).
assignment_groups:
  - name: Homework
    position: 1
    group_weight: 50
    drop_lowest: 1
  - name: Quizzes
    position: 2
    group_weight: 20
  - name: Project
    position: 3
    group_weight: 30

# Optional metadata passed to Pandoc when Markdown is rendered.
pandoc_metadata:
  term: "Spring 2026"

# Optional global variables for Jinja templates in Markdown files.
vars:
  instructor_name: "Ada Lovelace"

# Optional data available to templates as `site`.
data:
  course_title: "Example Course"

# Optional Markdown file used to update the Canvas course syllabus.
syllabus: syllabus/syllabus.md

modules:
  - name: "Getting Started"
    published: true
    items:
      - title: "Welcome"
        published: true
        page: pages/welcome.md

      - title: "Course Policies"
        published: true
        page_contents: |
          # Course Policies

          Add short inline Markdown here.

      - title: "Reference File"
        published: true
        file: files/reference.pdf

      - title: "External Resource"
        published: true
        url: "https://www.instructure.com/canvas"
        new_tab: true

  - name: "Week 1"
    published: true
    unlock_at: "1/12/2026 9:00am"
    items:
      - title: "Readings"
        published: true
        items:
          - title: "Week 1 Reading"
            published: true
            file: readings/week-01.pdf

      - title: "Assignment 1"
        published: true
        assignment: "Assignment 1"
        description: assignments/assignment-01.md
        points_possible: 100
        submission_types: [online_upload]
        allowed_extensions: [pdf, ipynb]
        grading_type: points
        assignment_group: Homework
        unlock_at: "1/12/2026 9:00am"
        due_at: "1/19/2026 11:59pm"

      - title: "Project Proposal"
        published: true
        assignment: "Project Proposal"
        submission_types: [online_upload]
        allowed_extensions: [pdf]
        assignment_group: Project
        # YAML rubric file; see README.md for the format.
        rubric: rubrics/proposal.yaml
        peer_reviews:
          anonymous: true
          automatic: true
          count: 2
        due_at: "1/19/2026 11:59pm"
